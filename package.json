{
  "name": "synfiniconstruction",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev --workspace server\" \"npm:dev --workspace client\"",
    "build": "npm --workspace client run build",
    "start": "npm --workspace server start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
